{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Recreation (clang and libc++, debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/recreation/${presetName}",
      "environment": {
        "NOCTURNE_LLVM_VERSION": "23"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-$env{NOCTURNE_LLVM_VERSION}",
        "CMAKE_CXX_COMPILER": "clang++-$env{NOCTURNE_LLVM_VERSION}",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "coverage",
      "displayName": "Recreation with source-based coverage",
      "inherits": "default",
      "cacheVariables": {
        "NOCTURNE_RECREATION_COVERAGE": "ON"
      }
    },
    {
      "name": "game",
      "displayName": "Recreation with the SDL adapters and the nocturne executable, optimized",
      "inherits": "default",
      "cacheVariables": {
        "NOCTURNE_RECREATION_GAME": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "game-debug",
      "displayName": "The game at -O0 but for its hot rendering paths, for stepping through",
      "inherits": "default",
      "cacheVariables": {
        "NOCTURNE_RECREATION_GAME": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "Coverage and the game together, as CI builds them",
      "inherits": "coverage",
      "cacheVariables": {
        "NOCTURNE_RECREATION_GAME": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "game", "configurePreset": "game" },
    { "name": "game-debug", "configurePreset": "game-debug" },
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } }
  ]
}
