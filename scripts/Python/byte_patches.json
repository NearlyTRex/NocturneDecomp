        {
            "name": "partial_register_returns",
            "description": "Replace partial register writes (MOV AL,reg) with full register moves to eliminate CONCAT/undefined artifacts",
            "patches": [
                {
                    "name": "getNextKeypress: MOV AL,BL return path 1",
                    "address": "0x005f2ee3",
                    "original": "88d8",
                    "patched":  "89d8",
                    "description": "MOV AL,BL -> MOV EAX,EBX to eliminate CONCAT31/undefined3 in return value"
                },
                {
                    "name": "getNextKeypress: MOV AL,BL return path 2",
                    "address": "0x005f2ef1",
                    "original": "88d8",
                    "patched":  "89d8",
                    "description": "MOV AL,BL -> MOV EAX,EBX to eliminate CONCAT31/undefined3 in return value"
                }
            ]
        },
        {
            "name": "partial_register_reads",
            "description": "Replace XOR+partial byte reads with full MOVZX to eliminate uint3/CONCAT artifacts from palette lookups",
            "patches": [
                {
                    "name": "loadCameraThumbnail: palette byte read G channel",
                    "address": "0x00576c13",
                    "original": "31d20fb6b8c03c65038a90c13c65030fb6b0c23c6503",
                    "patched":  "0fb6b8c03c65030fb690c13c65030fb6b0c23c650390",
                    "description": "XOR EDX,EDX + MOV DL,[palette+1] -> MOVZX EDX,[palette+1] to eliminate uint3 artifact"
                }
            ]
        },
        {
            "name": "partial_register_loop_temps",
            "description": "Change loop temp register from AL to CL to avoid partial EAX writes causing CONCAT/int3 artifacts",
            "patches": [
                {
                    "name": "CGame_processCheatCodes: history shift loop AL->CL",
                    "address": "0x004ddbc3",
                    "original": "8a83d831d8028883d931d802",
                    "patched":  "8a8bd831d802888bd931d802",
                    "description": "MOV AL,[history] / MOV [history+1],AL -> MOV CL / MOV CL to eliminate CONCAT31/int3"
                }
            ]
        },
        {
            "name": "dead_code_after_noreturn",
            "description": "Replace dead code after noreturn calls with clean return to eliminate iRam/null deref artifacts",
            "patches": [
                {
                    "name": "CPod_init: dead code after displayErrorAndQuit",
                    "address": "0x00550c63",
                    "original": "833b007402 5bc3",
                    "patched":  "5bc390909090 90",
                    "description": "Replace dead CMP [NULL],0 / JZ with POP EBX / RET to eliminate iRam00000000"
                }
            ]
        },
