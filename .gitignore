# CMake
/build/
/cmake-build-*/

# Game
# Extensions use [xX] character classes so a single line covers every
# case variant shipped by the Windows build (e.g. *.POD and *.pod).
*.[nN][oO][cC]
*.[pP][oO][dD]
*.[aA][vV][iI]
*.[eE][xX][eE]
!*.[eE][xX][eE]/
*.[jJ][pP][gG]
*.[gG][iI][fF]
*.[hH][tT][mM][lL]
*.[iI][nN][iI]
*.[iI][nN][xX]
*.[dD][lL][lL]
*.[iI][sS][uU]
*.[jJ][sS]
*.[tT][xX][tT]
