#!/usr/bin/env bash
# Generated by CMake. Do not edit — regenerated on every configure.
# Launches the Nocturne executable under GDB with sanitizer env defaults.
#
# On crash, GDB breaks automatically. Type `bt` for backtrace, `bt full`
# for locals, `info registers` for register state. `quit` to exit.
#
# Usage:
#   ./debug.sh                        # run under GDB, break on crash
#   ./debug.sh --some-game-arg        # args pass through to the exe

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
EXE="${SCRIPT_DIR}/nocturne"

if [[ ! -x "${EXE}" ]]; then
    echo "debug.sh: ${EXE} not found or not executable" >&2
    echo "          build it first: cmake --build --preset @NOCTURNE_PRESET_NAME@" >&2
    exit 127
fi

# Symbolizer
: "${ASAN_SYMBOLIZER_PATH:=@LLVM_SYMBOLIZER_PATH@}"
: "${UBSAN_SYMBOLIZER_PATH:=@LLVM_SYMBOLIZER_PATH@}"

# Sanitizer options — same as run.sh but with abort_on_error=1 so GDB
# catches the signal instead of ASan swallowing it silently.
: "${UBSAN_OPTIONS:=print_stacktrace=1:halt_on_error=1:symbolize=1}"
: "${ASAN_OPTIONS:=detect_leaks=0:abort_on_error=1:symbolize=1:print_stacktrace=1}"

export ASAN_SYMBOLIZER_PATH UBSAN_SYMBOLIZER_PATH UBSAN_OPTIONS ASAN_OPTIONS

exec gdb -q \
    -ex "set confirm off" \
    -ex "set pagination off" \
    -ex "handle SIGPIPE nostop noprint pass" \
    -ex "run $*" \
    -ex "bt" \
    -ex "echo \n--- registers ---\n" \
    -ex "info registers eip ebp esp eax ebx ecx edx esi edi" \
    -ex "echo \n--- Type 'bt full' for locals, 'quit' to exit ---\n" \
    "${EXE}"
