// Generated by cmake/write_version.cmake on every build. Do not edit, and do
// not include from a header that everything else includes — only
// shims/core/version.cpp reads it, so a new commit rebuilds one file rather
// than the tree.
#pragma once

#define NOCTURNE_VERSION       "@NOCTURNE_VERSION@"
#define NOCTURNE_VERSION_MAJOR @NOCTURNE_VERSION_MAJOR@
#define NOCTURNE_VERSION_MINOR @NOCTURNE_VERSION_MINOR@
#define NOCTURNE_VERSION_PATCH @NOCTURNE_VERSION_PATCH@

// git describe --tags --always --dirty, or the bare version when the tree is
// not a git checkout (a source archive, say).
#define NOCTURNE_VERSION_GIT   "@NOCTURNE_VERSION_GIT@"

// The preset this binary was configured with, and the build type.
#define NOCTURNE_VERSION_BUILD "@NOCTURNE_VERSION_BUILD@"
