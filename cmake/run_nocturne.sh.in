#!/usr/bin/env bash
# Generated by CMake. Do not edit — regenerated on every configure.
# Launches the Nocturne executable with sanitizer-friendly env defaults.
#
# Env vars are set with ${VAR:=default} so you can override any of them on the
# command line:
#   UBSAN_OPTIONS=halt_on_error=0 ./run.sh            # keep running past hits
#   ASAN_OPTIONS=detect_leaks=1   ./run.sh            # turn leak detection on
#   ./run.sh --some-game-arg                          # args pass through to the exe

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
EXE="${SCRIPT_DIR}/nocturne"

if [[ ! -x "${EXE}" ]]; then
    echo "run.sh: ${EXE} not found or not executable" >&2
    echo "        build it first: cmake --build --preset @NOCTURNE_PRESET_NAME@" >&2
    exit 127
fi

# Symbolizer — resolved at configure time. Empty if llvm-symbolizer wasn't
# found; in that case sanitizer reports fall back to raw addresses.
: "${ASAN_SYMBOLIZER_PATH:=@LLVM_SYMBOLIZER_PATH@}"
: "${UBSAN_SYMBOLIZER_PATH:=@LLVM_SYMBOLIZER_PATH@}"

# UBSan: full stack trace on every hit, abort on first hit. Flip halt_on_error
# to 0 when you want to batch-triage multiple UBSan reports in one run.
: "${UBSAN_OPTIONS:=print_stacktrace=1:halt_on_error=1:symbolize=1}"

# ASan: skip leak detection (game leaks at shutdown by design), keep
# symbolization on, don't abort on first report so you see the full UBSan
# context if both fire at once. Set abort_on_error=1 if you want a coredump.
: "${ASAN_OPTIONS:=detect_leaks=0:abort_on_error=0:symbolize=1:print_stacktrace=1}"

export ASAN_SYMBOLIZER_PATH UBSAN_SYMBOLIZER_PATH UBSAN_OPTIONS ASAN_OPTIONS

exec "${EXE}" "$@"
